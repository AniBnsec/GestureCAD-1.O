# ==============================================================================
# GESTURECAD STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Enterprise Touchless Drone CAD & Aerodynamic Simulation Platform
# ==============================================================================

# Server Network Configuration
PORT=5000
DATABASE_URL="file:./dev.db"

# AI Provider Selection: "auto", "cohere", "gemini", "openai", or "local"
AI_PROVIDER=auto

# ==============================================================================
# 8 CORE APIS & TECHNOLOGIES
# ==============================================================================

# 1. Google Gemini API (Priority: Essential)
# Purpose: AI design assistant and natural-language instructions
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.2

# 2. MediaPipe (Priority: Essential)
# Purpose: Hand gesture detection and tracking
MEDIAPIPE_MODEL_PATH=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision/wasm
MEDIAPIPE_DELEGATE=GPU
MEDIAPIPE_RUNNING_MODE=VIDEO
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.65
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.65

# 3. Three.js (Priority: Essential)
# Purpose: Interactive 3D drone modelling and visualization
THREE_RENDERER_PRECISION=highp
THREE_ANTIALIAS=true
THREE_POWER_PREFERENCE=high-performance
THREE_SHADOW_MAP_TYPE=PCFSoftShadowMap

# 4. OpenAI Speech API (Priority: Recommended)
# Purpose: Voice command recognition
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_LANGUAGE=en

# 5. CadQuery / OpenCascade (Priority: Essential)
# Purpose: Actual CAD geometry generation
CADQUERY_PYTHON_PATH=python
CADQUERY_KERNEL_URL=http://localhost:8000/cadquery
OPENCASCADE_VERSION=7.6.3
CADQUERY_EXPORT_FORMATS=STEP,IGES,STL,DXF
CADQUERY_TOLERANCE=0.001

# 6. MongoDB Atlas (Priority: Essential)
# Purpose: Store user projects and design configurations
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gesturecad_cloud?retryWrites=true&w=majority
MONGODB_DB_NAME=gesturecad_cloud
MONGODB_COLLECTION_DESIGNS=quadcopter_designs
MONGODB_COLLECTION_PROJECTS=user_projects

# 7. FastAPI (Priority: Essential)
# Purpose: Connect frontend, AI, and CAD engine
FASTAPI_GATEWAY_URL=http://localhost:8000
FASTAPI_SECRET_KEY=gesturecad-fastapi-microservice-secret-token
FASTAPI_TIMEOUT_MS=5000

# 8. Firebase Storage (Priority: Optional)
# Purpose: Store exported 3D models and project files
FIREBASE_PROJECT_ID=gesturecad-studio
FIREBASE_STORAGE_BUCKET=gesturecad-studio.appspot.com
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gesturecad-studio.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PUBLIC_URL_EXPIRY_DAYS=30

# Optional Cohere AI fallback
COHERE_API_KEY=your_cohere_api_key_here

# Frontend Vite Port & API Target
VITE_PORT=3000
VITE_API_URL=http://localhost:5000/api
